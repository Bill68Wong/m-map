# dependencies
/node_modules

# next.js
/.next/
/out/
# ★ 本机构建目录绕开方案（见 next.config.ts distDir 注释）：NEXT_DIST_DIR 可指向任意 .next-*
/.next-*/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — 密码与连接串只放本地，永不入库
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backups
/backups/

# 研究过程文件（含接口逆向分析，不入公开历史）
/.workbuddy/

# cloudflared 临时隧道工具（53MB 二进制，不入库）
/tools/cloudflared.exe

# 本地浏览器诊断脚本（机器特定路径，不入库）
/scripts/diag-browser.cjs
.dev.log

# 推送/打 tag 的过程日志（机器特定临时产物）
.push*.log

# 本地截图验证输出
/.verify/

# 追踪式计时采集产物（原始帧体量大，只留本地；脚本与 README 入库）
/data/tracking/*
!/data/tracking/README.md

# 路演/简报媒体（约 63MB，不入库；对应文档与截图已归档到 docs/）
/*.mp4
/*.pptx

# ★ 采集与同步脚本移出公开仓库（决策 D1 · 2026-10-30）
#   `scripts/track-collect.mjs` 含 DSAT 鉴权签名实现与内部接口地址；
#   `db/sync-all-routes.ts` 含 DSAT 未公开接口名。
#   ⇒ 两者均为**本地运维/采集工具**，Vercel 部署用不到（`scripts/`、`db/` 不参与 Next 打包），
#     移出后线上零影响；文件保留在本地工作区（见 README 的「本地专属脚本」一节）。
#   ⚠️ 换机器时需自行拷贝这两份文件；`npm run track:collect` / `npm run db:sync-all` 依赖它们。
/scripts/track-collect.mjs
/db/sync-all-routes.ts

.vercel
.env*
