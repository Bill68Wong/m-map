{
  "$name": "M Map Design Tokens",
  "$version": "1.0.0",
  "$description": "M Map 设计令牌（方向 A「站牌」框架 + V2「蓝主」配色）。主强调色 = 青花蓝 #1B4D8F；澳门绿 = 辅主题色。深色模式本次不做，沿用既有 prefers-color-scheme。",
  "$source": "docs/改版-M-Map-20260920/04-design-tokens.md",
  "color": {
    "surface": {
      "bg": { "value": "#F2F4F0", "type": "color", "$description": "页面底·冷雾白（避开米黄/奶油）" },
      "surface": { "value": "#FFFFFF", "type": "color", "$description": "卡片/浮层/底导" },
      "surface2": { "value": "#EAECE7", "type": "color", "$description": "次表面·置顶微底/内嵌块" }
    },
    "foreground": {
      "fg": { "value": "#0F1720", "type": "color", "$description": "主文本·近黑带蓝调 · 17.4:1" },
      "fg2": { "value": "#3A424E", "type": "color", "$description": "次级正文 · 10.4:1" },
      "muted": { "value": "#5A6472", "type": "color", "$description": "副文本 · 6.0:1" },
      "meta": { "value": "#6E7684", "type": "color", "$description": "元数据 · 4.6:1" }
    },
    "border": {
      "border": { "value": "#DCDCDF", "type": "color", "$description": "发丝线" },
      "border2": { "value": "#C7CBD1", "type": "color", "$description": "稍强分隔" },
      "borderStrong": { "value": "#1B4D8F", "type": "color", "$description": "[KEY] 主描边=青花蓝框（路牌语言）" }
    },
    "accent": {
      "accent": { "value": "#1B4D8F", "type": "color", "$description": "主强调·青花蓝 · 8.4:1" },
      "accentDeep": { "value": "#16406F", "type": "color", "$description": "深一档·硬投影色/按下态" },
      "accentSoft": { "value": "#E6ECF6", "type": "color", "$description": "浅底·选中背景" },
      "accentOn": { "value": "#FFFFFF", "type": "color", "$description": "accent 底上前景" },
      "accentHover": { "value": "#17447D", "type": "color" },
      "accentActive": { "value": "#123A66", "type": "color" }
    },
    "brandGreen": {
      "brandGreen": { "value": "#0B6E4F", "type": "color", "$description": "辅主题色·澳门绿(工作值,非官方) · 6.4:1" },
      "brandGreenDeep": { "value": "#08543C", "type": "color" },
      "brandGreenSoft": { "value": "#DCEBE2", "type": "color" },
      "brandGreenOn": { "value": "#FFFFFF", "type": "color" },
      "$alternateOfficial": {
        "value": "#00795E",
        "type": "color",
        "$description": "官方「澳门绿」(RGB 0,121,94)；Pantone 3295C 对应 #077662。仅当需对外宣称官方色时替换 brandGreen。"
      }
    },
    "semantic": {
      "success": { "value": "#0B6E4F", "type": "color", "$description": "= brandGreen 同源" },
      "successSoft": { "value": "#DCEBE2", "type": "color" },
      "warn": { "value": "#A85E00", "type": "color", "$description": "4.9:1" },
      "warnSoft": { "value": "#F7EBDB", "type": "color" },
      "danger": { "value": "#B4342A", "type": "color", "$description": "6.1:1" },
      "dangerSoft": { "value": "#F7E3E0", "type": "color" },
      "info": { "value": "{color.accent.accent}", "type": "color" }
    },
    "$routeColors": {
      "value": null,
      "type": "note",
      "$description": "[KEY] 线路标签色【不纳入 Token 体系】。巴士/轻轨线路码颜色 = 既有线路数据（RouteStack colorOf 从 routes.color 取），与项目主题色无关、不随主题色变化、禁止硬编码。"
    },
    "$brandColorFocusRule": {
      "value": null,
      "type": "note",
      "$description": "硬规则：同一屏同一视觉焦点只允许出现一个品牌色。青花蓝与澳门绿不得并置于同一焦点；面积(蓝) ≥ 面积(绿) 恒成立。蓝岗位 = CTA/选中态/主描边/地图边界；绿岗位 = 正向状态语义 + 品牌点缀（每屏 ≤1 处）。"
    }
  },
  "font": {
    "family": {
      "display": { "value": "Barlow, Noto Sans SC, -apple-system, PingFang SC, sans-serif", "type": "fontFamily" },
      "body": { "value": "Barlow, Noto Sans SC, -apple-system, PingFang SC, sans-serif", "type": "fontFamily" },
      "mono": { "value": "JetBrains Mono, Barlow, monospace", "type": "fontFamily" }
    },
    "weight": {
      "read": { "value": "400", "type": "fontWeight" },
      "emphasize": { "value": "600", "type": "fontWeight" },
      "announce": { "value": "700", "type": "fontWeight" }
    },
    "size": {
      "2xs": { "value": "11px", "type": "dimension", "$description": "大写小标签" },
      "xs": { "value": "12px", "type": "dimension", "$description": "chip/线路码" },
      "sm": { "value": "13px", "type": "dimension", "$description": "meta 副行" },
      "md": { "value": "15px", "type": "dimension", "$description": "正文基准" },
      "lg": { "value": "17px", "type": "dimension", "$description": "lead" },
      "xl": { "value": "20px", "type": "dimension", "$description": "标题/路线名" },
      "2xl": { "value": "26px", "type": "dimension", "$description": "小标题/大数字" },
      "3xl": { "value": "32px", "type": "dimension", "$description": "展示字" }
    },
    "leading": {
      "tight": { "value": "1.15", "type": "number" },
      "title": { "value": "1.3", "type": "number" },
      "body": { "value": "1.55", "type": "number" },
      "loose": { "value": "1.7", "type": "number" }
    },
    "tracking": {
      "display": { "value": "-0.02em", "type": "dimension", "$description": "≥28px" },
      "title": { "value": "-0.01em", "type": "dimension", "$description": "20–26px" },
      "body": { "value": "0", "type": "dimension", "$description": "13–17px" },
      "label": { "value": "0.09em", "type": "dimension", "$description": "11px 大写" },
      "mono": { "value": "0.01em", "type": "dimension" }
    },
    "$numericRule": {
      "value": "font-variant-numeric: tabular-nums",
      "type": "note",
      "$description": "所有数字（时刻/分钟/站数/坐标/线路码）必须 tabular 对齐。"
    }
  },
  "space": {
    "1": { "value": "4px", "type": "dimension" },
    "2": { "value": "8px", "type": "dimension" },
    "3": { "value": "12px", "type": "dimension" },
    "4": { "value": "16px", "type": "dimension" },
    "5": { "value": "20px", "type": "dimension" },
    "6": { "value": "24px", "type": "dimension" },
    "7": { "value": "32px", "type": "dimension" },
    "8": { "value": "40px", "type": "dimension" },
    "9": { "value": "48px", "type": "dimension" },
    "10": { "value": "64px", "type": "dimension" },
    "11": { "value": "80px", "type": "dimension" }
  },
  "radius": {
    "chip": { "value": "6px", "type": "dimension", "$description": "线路码标签" },
    "group": { "value": "7px", "type": "dimension", "$description": "多码组胶囊" },
    "btn": { "value": "8px", "type": "dimension", "$description": "按钮（非 pill）" },
    "card": { "value": "10px", "type": "dimension", "$description": "卡片/搜索条/浮层" },
    "sheet": { "value": "14px", "type": "dimension", "$description": "底部弹层顶角" },
    "full": { "value": "999px", "type": "dimension", "$description": "仅圆点/头像/定位按钮" }
  },
  "border": {
    "frameW": { "value": "1.5px", "type": "dimension" },
    "frameWEmph": { "value": "2px", "type": "dimension" }
  },
  "shadow": {
    "none": { "value": "none", "type": "boxShadow" },
    "hairline": { "value": "0 0 0 1px #DCDCDF", "type": "boxShadow" },
    "hardSm": { "value": "2px 2px 0 0 #1B4D8F", "type": "boxShadow", "$description": "小实体" },
    "hard": { "value": "3px 3px 0 0 #1B4D8F", "type": "boxShadow", "$description": "主实体·零模糊" },
    "sheet": { "value": "0 -6px 24px rgba(15,23,32,0.12)", "type": "boxShadow", "$description": "唯一允许的柔和抬升（浮在地图上）" },
    "$rule": {
      "value": null,
      "type": "note",
      "$description": "禁止 1px 边框 + ≥16px blur 阴影同现于同一元素（幽灵卡片）。默认零模糊阴影。"
    }
  },
  "focus": {
    "ring": { "value": "0 0 0 3px rgba(27,77,143,0.32)", "type": "boxShadow" }
  },
  "motion": {
    "duration": {
      "instant": { "value": "90ms", "type": "duration" },
      "fast": { "value": "150ms", "type": "duration" },
      "base": { "value": "200ms", "type": "duration" },
      "slow": { "value": "300ms", "type": "duration" }
    },
    "easing": {
      "standard": { "value": "cubic-bezier(0.2, 0, 0, 1)", "type": "cubicBezier" },
      "springRelease": { "value": "cubic-bezier(0.22, 1.9, 0.36, 1)", "type": "cubicBezier", "$description": "保留现状按压回弹" }
    },
    "$reducedMotion": {
      "value": "@media (prefers-reduced-motion: reduce) { * { transition-duration:0.01ms; animation:none } }",
      "type": "note",
      "$description": "必须支持；禁用位移与回弹。"
    }
  },
  "icon": {
    "size": {
      "sm": { "value": "16px", "type": "dimension", "$description": "行内" },
      "md": { "value": "20px", "type": "dimension", "$description": "按钮内/列表前导" },
      "lg": { "value": "24px", "type": "dimension", "$description": "底导/独立" }
    },
    "stroke": { "value": "2px", "type": "dimension" },
    "cap": { "value": "butt", "type": "string" },
    "join": { "value": "miter", "type": "string" },
    "viewBox": { "value": "0 0 24 24", "type": "string" },
    "$scope": {
      "value": null,
      "type": "note",
      "$description": "[KEY] 全站范围：零 emoji / 零 Unicode 字符当图标（清理覆盖含旧版功能页 30+ 处）；全站仅一套线性库、仅 16/20/24 三档、不混用。"
    }
  },
  "layout": {
    "containerMobile": { "value": "480px", "type": "dimension" },
    "containerDesktop": { "value": "1200px", "type": "dimension" },
    "tabbarH": { "value": "64px", "type": "dimension" },
    "safeBottom": { "value": "env(safe-area-inset-bottom, 0px)", "type": "string" },
    "safeTop": { "value": "env(safe-area-inset-top, 0px)", "type": "string" },
    "sheetGutter": { "value": "16px", "type": "dimension" },
    "sectionY": {
      "phone": { "value": "24px", "type": "dimension" },
      "tablet": { "value": "32px", "type": "dimension" },
      "desktop": { "value": "48px", "type": "dimension" }
    }
  }
}
