#!/bin/sh
# 推送前门禁（铁律 56 / 58）· 2026-11-05 立
#                                  2026-11-13 增补：合作者动态检查
#
# 三段串联执行，退出码取最严（BLOCK > CONFIRM > PASS）：
#   ① check-peer-activity : 远端协作动态（远端 main 是否前进、是否有别人 open PR 且文件重叠）
#                          —— 需要网络；网络不可达时降级为 PASS 并告警
#   ② review-push        : 本地文件分类 / 敏感扫描 / 必要性清单 —— 纯离线
#   ③ test:readme-version: README 版本号是否与 package.json 一致 —— 纯离线、毫秒级
#                          拦的是「对外文档撒谎」：README 写 v4.2.1、实际装的是别的版本。
#                          红了直接 BLOCK，并提示 `npm run docs:sync-version` 修复。
#
# 为什么 ③ 排在最后：三段**都不短路**（全跑完才聚合），顺序只影响报告次序。
#   ① 需要网络、耗时最长；把 ①② 的实质结论先出，③ 这条毫秒级校核收尾。
#   （「为尽早看到 ③ 失败而放最前」并不成立 —— 三段无论如何都要跑完才判定，
#     放最前只会把 ①② 的结论挤到后面，不会让推送更早被拦。）
#
# ⚠️ 钩子只做**检测**，绝不写文件：在钩子里跑 `docs:sync-version` 属意外副作用，
#   且钩子改出的 README 不在待推的 commit 里，照样得再提交一次 ⇒ 反而更绕。
#
# 放行规则（三段同一语义）：
#   exit 0 = PASS                          → 放行
#   exit 2 = CONFIRM（分类不明/大批量/协作未验证） → 默认拒绝；只有 PUSH_APPROVED=1 才放行
#   exit 1 = BLOCK（禁止类型/敏感内容/主线已前进/README 版本过期） → 一律拒绝，PUSH_APPROVED 也不放行
#
# PUSH_APPROVED=1 的语义 =「负责人已在对话中看过清单并明确同意」。
# 它不是万能钥匙：只解锁 CONFIRM，不解锁 BLOCK。
set -u

if ! command -v node >/dev/null 2>&1; then
  echo "[pre-push] 找不到 node，无法出具审核清单 ⇒ 拒绝推送（默认方向为失败）" >&2
  exit 1
fi

# ③ 走 `npm run test:readme-version`，故 npm 与 node 一样是硬依赖。
# 不显式检查的话，「有 node 无 npm」会落到 127 ⇒ 异常退出码兜底分支，
# 虽然方向仍是 BLOCK（安全），但报错是「检测到异常退出码（③=127）」，指向性弱。
if ! command -v npm >/dev/null 2>&1; then
  echo "[pre-push] 找不到 npm，无法校核 README 版本 ⇒ 拒绝推送（默认方向为失败）" >&2
  exit 1
fi

# ── ① 合作者动态检查（需要网络）───────────────────────────────────────
echo ""
echo "[pre-push] ① 合作者动态检查（远端 main 同步 / 他人 open PR 重叠）"
node scripts/check-peer-activity.mjs
peer_code=$?
echo "[pre-push] ① 结论：exit=$peer_code"

# ── ② 本地推送审核（纯离线）───────────────────────────────────────────
echo ""
echo "[pre-push] ② 本地推送审核（文件分类 / 敏感扫描 / 必要性清单）"
node scripts/review-push.mjs
review_code=$?
echo "[pre-push] ② 结论：exit=$review_code"

# ── ③ README 版本号同步（纯离线、毫秒级，只检测不写文件）──────────────
echo ""
echo "[pre-push] ③ README 版本号与 package.json 一致性"
npm run test:readme-version --silent
readme_code=$?
echo "[pre-push] ③ 结论：exit=$readme_code"
if [ "$readme_code" -ne 0 ]; then
  echo "[pre-push] ③ 修复：npm run docs:sync-version（然后提交 README 改动）" >&2
fi

# ── 取最严：1（BLOCK）> 2（CONFIRM）> 0（PASS）─────────────────────────
code=0
if [ "$peer_code" -eq 1 ] || [ "$review_code" -eq 1 ] || [ "$readme_code" -eq 1 ]; then
  code=1
elif [ "$peer_code" -eq 2 ] || [ "$review_code" -eq 2 ] || [ "$readme_code" -eq 2 ]; then
  code=2
elif [ "$peer_code" -ne 0 ] || [ "$review_code" -ne 0 ] || [ "$readme_code" -ne 0 ]; then
  # 非 0/1/2 的异常退出码（如脚本缺失 127、npm 不可用）一律按 BLOCK 处理（默认方向为失败）
  echo "[pre-push] 检测到异常退出码（①=$peer_code，②=$review_code，③=$readme_code）⇒ 按 BLOCK 处理"
  code=1
fi

echo ""
echo "[pre-push] 合并判定：取最严 ⇒ exit=$code（①=$peer_code，②=$review_code，③=$readme_code）"

case "$code" in
  0)
    exit 0
    ;;
  2)
    if [ "${PUSH_APPROVED:-0}" = "1" ]; then
      echo ""
      echo "[pre-push] CONFIRM 已放行（PUSH_APPROVED=1）。请确认：本次清单已逐项向负责人说明并获同意。"
      exit 0
    fi
    echo ""
    echo "[pre-push] CONFIRM：清单已列出，但尚未获得确认 ⇒ 拒绝推送。"
    echo "[pre-push] 确认后：PUSH_APPROVED=1 git push ...（仅在负责人明确同意后使用）"
    exit 1
    ;;
  *)
    echo ""
    echo "[pre-push] BLOCK：存在禁止入库文件/敏感内容，或远端主线已前进/协作状态未验证/README 版本过期 ⇒ 拒绝推送（铁律 56/57）。"
    echo "[pre-push] 处理：按上面三段报告修正后重新推送；不得绕过。"
    exit 1
    ;;
esac
